generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"
  url = env("DATABASE_URL") }

enum Role { CUSTOMER VENDOR DELIVERY ADMIN }
enum ItemStatus { PLACED SHIPPED DELIVERED }

model User {
  id       Int         @id @default(autoincrement())
  name     String
  email    String      @unique
  password String
  role     Role        @default(CUSTOMER)
  products Product[]
  orders   Order[]
  sales    OrderItem[]
}
model Product {
  id           Int         @id @default(autoincrement())
  vendorId     Int
  name         String
  description  String      @default("")
  category     String
  price        Int
  stock        Int
  promoPercent Int         @default(0)
  imageUrl     String?
  vendor       User        @relation(fields: [vendorId], references: [id])
  items        OrderItem[]
}
model Order {
  id         Int         @id @default(autoincrement())
  customerId Int
  total      Int
  paid       Boolean     @default(false)
  createdAt  DateTime    @default(now())
  customer   User        @relation(fields: [customerId], references: [id])
  items      OrderItem[]
}
model OrderItem {
  id         Int        @id @default(autoincrement())
  orderId    Int
  productId  Int
  vendorId   Int
  qty        Int
  price      Int
  commission Int
  status     ItemStatus @default(PLACED)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
  vendor     User       @relation(fields: [vendorId], references: [id])
}
